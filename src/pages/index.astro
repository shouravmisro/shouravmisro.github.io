---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { loadSiteJson } from "../lib/sitejson";

const data = loadSiteJson();
const b = data.basics;

const headshot =
  b.headshotUrl && typeof b.headshotUrl === "string" && b.headshotUrl.trim().length > 0
    ? b.headshotUrl
    : null;

const featuredProjects = data.projects.filter((p) => p.featured).slice(0, 4);
---

<BaseLayout title={`${b.name} — Portfolio`} description={b.headline}>
  <section class="py-10 sm:py-14">
    <Container>
      <div class="relative overflow-hidden rounded-3xl border border-[rgb(var(--border))]">
        <div class="mesh"></div>

        <div class="relative p-6 sm:p-8 lg:p-10">
          <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
            <div class="max-w-2xl">
              <p class="text-sm text-[rgb(var(--fg)/0.60)] reveal">{b.location ?? ""}</p>

              <h1 class="mt-3 max-w-[12ch] text-4xl font-extrabold leading-[0.95] tracking-tight sm:text-5xl lg:text-6xl reveal">
                SQA / QA and IoT / Embedded-focused engineer
              </h1>

              <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-[rgb(var(--fg)/0.75)] reveal">
                I’m <span class="font-semibold">{b.name}</span>, a CSE graduate working across
                software quality assurance and IoT / embedded systems — validating products,
                finding practical issues, and building dependable solutions.
              </p>

              <div class="mt-5 flex flex-wrap gap-2 reveal">
                {b.roles?.map((r) => (
                  <span class="rounded-full border border-[rgb(var(--border))] bg-[rgb(var(--bg)/0.30)] px-3 py-1 text-xs text-[rgb(var(--fg)/0.75)]">
                    {r}
                  </span>
                ))}
              </div>

              <div class="mt-7 flex flex-wrap gap-3 reveal">
                <Button href="/cv">Resume / CV</Button>
                <Button href="/projects" variant="secondary">Projects</Button>
                <Button href="/contact" variant="secondary">Contact</Button>
                {b.github && <Button href={b.github} variant="secondary">GitHub</Button>}
              </div>
            </div>

            <div class="reveal">
              <div class="mx-auto w-full max-w-sm">
                <div class="card p-5" data-spotlight>
                  <div class="flex items-center gap-4">
                    {headshot ? (
                      <img
                        src={headshot}
                        alt={`${b.name} headshot`}
                        class="h-20 w-20 shrink-0 rounded-full border border-[rgb(var(--border))] object-cover sm:h-24 sm:w-24"
                        loading="lazy"
                      />
                    ) : (
                      <div class="h-20 w-20 shrink-0 rounded-full border border-[rgb(var(--border))] bg-[rgb(var(--fg)/0.06)] sm:h-24 sm:w-24" />
                    )}

                    <div class="min-w-0">
                      <div class="truncate text-xl font-bold">{b.name}</div>
                      <div class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">
                        SQA • QA • IoT / Embedded
                      </div>
                    </div>
                  </div>

                  <div class="mt-5 grid gap-2">
                    <a
                      class="rounded-xl border border-[rgb(var(--border))] px-4 py-2 text-sm hover:bg-[rgb(var(--fg)/0.06)] transition"
                      href="/projects"
                    >
                      View Projects →
                    </a>
                    <a
                      class="rounded-xl border border-[rgb(var(--border))] px-4 py-2 text-sm hover:bg-[rgb(var(--fg)/0.06)] transition"
                      href="/cv"
                    >
                      View CV →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {featuredProjects.length > 0 && (
            <div class="mt-10 grid gap-4 md:grid-cols-2">
              {featuredProjects.map((p) => (
                <article class="card p-5 reveal" data-spotlight>
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <h2 class="text-lg font-bold">{p.title}</h2>
                      <p class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">{p.role}</p>
                    </div>
                    <span class="text-xs text-[rgb(var(--fg)/0.60)]">{p.year}</span>
                  </div>
                  <p class="mt-3 text-sm text-[rgb(var(--fg)/0.75)]">{p.summary}</p>
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>