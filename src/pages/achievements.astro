---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---
<BaseLayout title="Achievements" description="Awards and milestones">
  <section class="py-14">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">Achievements</h1>
      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        Coming next: your awards and competitions (from your CV).
      </p>
    </Container>
  </section>
</BaseLayout>