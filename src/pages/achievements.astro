---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import { loadSiteJson } from "../lib/sitejson";

const data = loadSiteJson();
const items = [...data.achievements];
---

<BaseLayout title="Achievements" description="Competitions, awards, and highlights">
  <section class="py-12">
    <Container>
      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight reveal">Achievements</h1>
        <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
          Competitions, recognitions, and personal highlights across QA, robotics, and extracurricular work.
        </p>
      </div>

      <div class="mt-10 grid gap-4">
        {items.map((a) => (
          <article class="card p-6 reveal" data-spotlight>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold">{a.title}</h2>
                {a.org && <p class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">{a.org}</p>}
              </div>
              <span class="text-xs text-[rgb(var(--fg)/0.60)]">{a.date}</span>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>