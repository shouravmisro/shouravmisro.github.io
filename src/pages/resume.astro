---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { site } from "../lib/site";
---

<BaseLayout title="Resume" description="Download my resume">
  <section class="py-14">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">
        Resume
      </h1>

      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        Download the PDF or view it below.
      </p>

      <div class="mt-6 flex flex-wrap gap-3 reveal">
        <Button href={site.resumeUrl}>Download PDF</Button>
        <Button href="/contact" variant="secondary">Contact</Button>
      </div>

      <div class="mt-10 overflow-hidden rounded-2xl border border-[rgb(var(--border))] reveal">
        <iframe
          title="Resume"
          src={site.resumeUrl}
          class="h-[80vh] w-full"
        ></iframe>
      </div>

      <p class="mt-4 text-xs text-[rgb(var(--fg)/0.55)] reveal">
        Place your resume file here:
        <code class="rounded bg-[rgb(var(--fg)/0.08)] px-1.5 py-0.5">
          public/resume.pdf
        </code>
      </p>
    </Container>
  </section>
</BaseLayout>