---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { getBlogPosts } from "../../data/blogs";

const posts = await getBlogPosts();
const sqaPosts = posts.filter(p => p.category === 'SQA');
const otherPosts = posts.filter(p => p.category !== 'SQA');
---

<BaseLayout title="SQA Articles & Notes" description="Software Quality Assurance notes, test case design guides, and API testing insights">
  <section class="py-12 lg:py-20 min-h-[100dvh]">
    <Container>
      <div class="max-w-3xl mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-400">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          <span class="text-xs font-semibold uppercase tracking-widest">SQA Profile Blog</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
          SQA &amp; Testing <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-500">Articles</span>
        </h1>
        <p class="mt-4 text-[rgb(var(--fg)/0.70)] text-base md:text-lg leading-relaxed">
          Manual testing strategies, bug lifecycle management, Postman collection automation, and quality assurance notes.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {[...sqaPosts, ...otherPosts].map((p) => (
          <article class="blog-card card p-6 lg:p-7 flex flex-col justify-between group transition-all duration-300 hover:-translate-y-1">
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class={`px-2.5 py-1 rounded-md text-[0.65rem] font-bold uppercase tracking-wider border ${p.category === 'SQA' ? 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30' : 'bg-[rgb(var(--fg)/0.05)] text-[rgb(var(--fg)/0.6)] border-[rgb(var(--border))]'}`}>
                  {p.category}
                </span>
                <span class="text-xs font-mono text-[rgb(var(--fg)/0.4)]">{p.date} · {p.readTime}</span>
              </div>

              <h2 class="text-xl font-bold mb-3 group-hover:text-indigo-400 transition-colors">
                <a href={`/blog/${p.slug}`} class="focus:outline-none">{p.title}</a>
              </h2>
              <p class="text-sm text-[rgb(var(--fg)/0.65)] leading-relaxed mb-6">
                {p.description}
              </p>
            </div>

            <div>
              <div class="flex flex-wrap gap-1.5 mb-5">
                {p.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-md bg-[rgb(var(--fg)/0.04)] text-[0.7rem] font-medium text-[rgb(var(--fg)/0.6)] border border-[rgb(var(--border))]">
                    {tag}
                  </span>
                ))}
              </div>

              <a href={`/blog/${p.slug}`} class="inline-flex items-center gap-1.5 text-xs font-bold text-[rgb(var(--fg)/0.8)] group-hover:text-[rgb(var(--fg))] transition-colors">
                Read Article <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
