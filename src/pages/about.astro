---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---
<BaseLayout title="About" description="About me">
  <section class="py-14">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">About</h1>
      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        Coming next: a polished story section + strengths + focus areas (SQA / QA / IoT).
      </p>
    </Container>
  </section>
</BaseLayout>