---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---
<BaseLayout title="Projects" description="Selected work and case studies">
  <section class="py-14">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">Projects</h1>
      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        Coming next: filterable projects + detailed case studies.
      </p>
    </Container>
  </section>
</BaseLayout>