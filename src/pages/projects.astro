---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { loadSiteJson } from "../lib/sitejson";

const data = loadSiteJson();

const featured = [...data.projects].sort((a, b) => Number(b.featured) - Number(a.featured));

const qaProjects = featured.filter((p) =>
  p.stack.some((s) =>
    ["QA", "Manual Testing", "Functional Testing", "Regression Testing", "Postman"].includes(s)
  )
);

const iotProjects = featured.filter((p) =>
  p.stack.some((s) =>
    ["IoT", "Embedded", "ESP32", "Arduino", "Raspberry Pi", "Firmware"].includes(s)
  )
);

const otherProjects = featured.filter(
  (p) => !qaProjects.includes(p) && !iotProjects.includes(p)
);
---

<BaseLayout title="Projects" description="Selected work and practical projects">
  <section class="py-12">
    <Container>
      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight reveal">Projects</h1>
        <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
          A selection of my QA/testing work, IoT/embedded projects, and technical builds.
          Links can be added later.
        </p>
      </div>

      {qaProjects.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold reveal">QA / Testing Projects</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {qaProjects.map((p) => (
              <article class="card p-6 reveal" data-spotlight>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-lg font-bold">{p.title}</h3>
                    <p class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">{p.role}</p>
                  </div>
                  <span class="text-xs text-[rgb(var(--fg)/0.60)]">{p.year}</span>
                </div>

                <p class="mt-3 text-sm text-[rgb(var(--fg)/0.75)]">{p.summary}</p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {p.stack.map((t) => (
                    <span class="rounded-full border border-[rgb(var(--border))] px-3 py-1 text-xs text-[rgb(var(--fg)/0.70)]">
                      {t}
                    </span>
                  ))}
                </div>

                {(p.github || p.demo) && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {p.github && <Button href={p.github} variant="secondary">GitHub</Button>}
                    {p.demo && <Button href={p.demo}>Demo</Button>}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      {iotProjects.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold reveal">IoT / Embedded Projects</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {iotProjects.map((p) => (
              <article class="card p-6 reveal" data-spotlight>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-lg font-bold">{p.title}</h3>
                    <p class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">{p.role}</p>
                  </div>
                  <span class="text-xs text-[rgb(var(--fg)/0.60)]">{p.year}</span>
                </div>

                <p class="mt-3 text-sm text-[rgb(var(--fg)/0.75)]">{p.summary}</p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {p.stack.map((t) => (
                    <span class="rounded-full border border-[rgb(var(--border))] px-3 py-1 text-xs text-[rgb(var(--fg)/0.70)]">
                      {t}
                    </span>
                  ))}
                </div>

                {(p.github || p.demo) && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {p.github && <Button href={p.github} variant="secondary">GitHub</Button>}
                    {p.demo && <Button href={p.demo}>Demo</Button>}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      {otherProjects.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold reveal">Other Technical Projects</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {otherProjects.map((p) => (
              <article class="card p-6 reveal" data-spotlight>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-lg font-bold">{p.title}</h3>
                    <p class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">{p.role}</p>
                  </div>
                  <span class="text-xs text-[rgb(var(--fg)/0.60)]">{p.year}</span>
                </div>

                <p class="mt-3 text-sm text-[rgb(var(--fg)/0.75)]">{p.summary}</p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {p.stack.map((t) => (
                    <span class="rounded-full border border-[rgb(var(--border))] px-3 py-1 text-xs text-[rgb(var(--fg)/0.70)]">
                      {t}
                    </span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </Container>
  </section>
</BaseLayout>