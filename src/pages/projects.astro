---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { loadSiteJson } from "../lib/sitejson";

const data = loadSiteJson();
const b = data.basics;
const featured = [...data.projects].sort((a, c) => Number(c.featured) - Number(a.featured));
---

<BaseLayout title="Projects" description="Selected work and case studies">
  <section class="py-14">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">Projects</h1>
      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        Selected work. Featured projects appear first.
      </p>

      {featured.length === 0 ? (
        <div class="mt-8 card p-6 reveal" data-spotlight>
          <p class="text-[rgb(var(--fg)/0.70)]">
            No projects added yet. Go to <a class="underline" href="/make">/make</a>, add projects, export, then overwrite
            <code> public/site.json</code>.
          </p>
          {b.github && <div class="mt-3"><Button href={b.github} variant="secondary">Open GitHub</Button></div>}
        </div>
      ) : (
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {featured.map((p) => (
            <article class="card p-6 reveal" data-spotlight>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h2 class="text-lg font-bold">{p.title}</h2>
                  <p class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">{p.role}</p>
                </div>
                <span class="text-xs text-[rgb(var(--fg)/0.60)]">{p.year}</span>
              </div>

              <p class="mt-3 text-sm text-[rgb(var(--fg)/0.75)]">{p.summary}</p>

              {p.stack?.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {p.stack.map((t) => (
                    <span class="rounded-full border border-[rgb(var(--border))] px-3 py-1 text-xs text-[rgb(var(--fg)/0.70)]">
                      {t}
                    </span>
                  ))}
                </div>
              )}

              <div class="mt-5 flex flex-wrap gap-2">
                {p.github && <Button href={p.github} variant="secondary">GitHub</Button>}
                {p.demo && <Button href={p.demo}>Demo</Button>}
              </div>
            </article>
          ))}
        </div>
      )}
    </Container>
  </section>
</BaseLayout>