---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---
<BaseLayout title="Blog" description="Writing and notes">
  <section class="py-14">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">Blog</h1>
      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        Coming next: clean blog list + posts (based on your projects).
      </p>
    </Container>
  </section>
</BaseLayout>