---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

const topics = [
  "SQA learning notes and practical testing insights",
  "Bug reporting and QA workflow observations",
  "IoT / embedded build logs and engineering notes",
  "Project lessons from QA and hardware systems",
  "Career, tools, and practical problem-solving reflections"
];
---

<BaseLayout title="Blog" description="Notes, ideas, and technical reflections">
  <section class="py-12">
    <Container>
      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight reveal">Blog</h1>
        <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
          I’ll use this section to share practical notes from software testing, IoT / embedded work,
          project building, and learning experiences.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {topics.map((topic) => (
          <article class="card p-6 reveal" data-spotlight>
            <h2 class="text-lg font-bold">{topic}</h2>
            <p class="mt-3 text-sm text-[rgb(var(--fg)/0.72)]">
              Coming soon.
            </p>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>