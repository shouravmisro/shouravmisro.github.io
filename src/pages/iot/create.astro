---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
---

<BaseLayout title="Create your own portfolio — IoT Profile" description="Fork this template and build your own website + CV">
  <section class="py-14 min-h-[100dvh]">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">Create your own portfolio + CV</h1>
      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        This site is a template. You can fork it, fill the wizard, export files, and deploy your own portfolio on GitHub Pages.
      </p>

      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Step 1 — Fork the repo</h2>
          <p class="mt-2 text-sm text-[rgb(var(--fg)/0.70)]">
            Fork the repository to your GitHub account.
          </p>
        </div>

        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Step 2 — Open the builder</h2>
          <p class="mt-2 text-sm text-[rgb(var(--fg)/0.70)]">
            Visit <code>/make</code> on your forked site and fill the wizard.
          </p>
          <div class="mt-3">
            <Button href="/make" variant="secondary">Open /make</Button>
          </div>
        </div>

        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Step 3 — Export files</h2>
          <p class="mt-2 text-sm text-[rgb(var(--fg)/0.70)]">
            Export <code>site.json</code> and <code>cv.html</code>.
          </p>
        </div>

        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Step 4 — Replace files in your repo</h2>
          <p class="mt-2 text-sm text-[rgb(var(--fg)/0.70)]">
            Overwrite:
            <br />
            <code>public/site.json</code>
            <br />
            <code>public/cv.html</code>
          </p>
        </div>

        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Step 5 — Commit &amp; push</h2>
          <p class="mt-2 text-sm text-[rgb(var(--fg)/0.70)]">
            Push changes to <code>main</code>. GitHub Actions deploys automatically.
          </p>
        </div>

        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Step 6 — Optional</h2>
          <p class="mt-2 text-sm text-[rgb(var(--fg)/0.70)]">
            Add screenshots into <code>public/projects</code> and link them later.
          </p>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
        <h2 class="font-bold">Troubleshooting</h2>
        <ul class="mt-3 list-disc pl-5 text-sm text-[rgb(var(--fg)/0.70)]">
          <li>If your site doesn’t update, check Actions tab for deployment logs.</li>
          <li>Make sure GitHub Pages is set to “GitHub Actions”.</li>
          <li>Validate your <code>site.json</code> from the builder.</li>
        </ul>
      </div>
    </Container>
  </section>
</BaseLayout>
