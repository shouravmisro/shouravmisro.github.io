---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
import { loadSiteJson } from "../../lib/sitejson";

const data = loadSiteJson();
const b = data.basics;
---

<BaseLayout title="Contact — IoT Profile" description="Get in touch for IoT & Embedded Engineering opportunities">
  <section class="py-12 min-h-[100dvh]">
    <Container>
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-pink-500/30 bg-pink-500/10 text-pink-400">
          <span class="w-2 h-2 rounded-full bg-pink-500"></span>
          <span class="text-xs font-semibold uppercase tracking-widest">IoT Profile</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight">Contact</h1>
        <p class="mt-3 text-[rgb(var(--fg)/0.70)]">
          I’m open to opportunities in IoT Development, Embedded Systems Engineering, microcontrollers, and hardware projects.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={`mailto:${b.email}`}>Email</Button>
          {b.github && <Button href={b.github} variant="secondary">GitHub</Button>}
          {b.facebook && <Button href={b.facebook} variant="secondary">Facebook</Button>}
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="card p-5" data-spotlight>
            <div class="text-sm text-[rgb(var(--fg)/0.60)]">Email</div>
            <div class="mt-2 font-semibold">{b.email}</div>
          </div>

          <div class="card p-5" data-spotlight>
            <div class="text-sm text-[rgb(var(--fg)/0.60)]">Phone</div>
            <div class="mt-2 font-semibold">{b.phone}</div>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
