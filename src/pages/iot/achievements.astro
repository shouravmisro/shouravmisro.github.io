---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { loadSiteJson } from "../../lib/sitejson";

const data = loadSiteJson();
const items = [...data.achievements];
---

<BaseLayout title="IoT Achievements — Portfolio" description="Competitions, awards, and highlights for IoT profile">
  <section class="py-12 min-h-[100dvh]">
    <Container>
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-pink-500/30 bg-pink-500/10 text-pink-400">
          <span class="w-2 h-2 rounded-full bg-pink-500"></span>
          <span class="text-xs font-semibold uppercase tracking-widest">IoT Profile</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight">Achievements</h1>
        <p class="mt-3 text-[rgb(var(--fg)/0.70)]">
          Competitions, robotics recognitions, and hardware hackathon victories.
        </p>
      </div>

      <div class="mt-10 grid gap-4">
        {items.map((a) => (
          <article class="card p-6" data-spotlight>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold">{a.title}</h2>
                {a.org && <p class="mt-1 text-sm text-[rgb(var(--fg)/0.70)]">{a.org}</p>}
              </div>
              <span class="text-xs text-[rgb(var(--fg)/0.60)]">{a.date}</span>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
