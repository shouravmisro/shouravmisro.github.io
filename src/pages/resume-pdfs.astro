---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { loadSiteJson } from "../lib/sitejson";

const data = loadSiteJson();
const b = data.basics;

const sqa = b.resumeSqaUrl ?? "/resume-sqa.pdf";
const iot = b.resumeIotUrl ?? "/resume-iot.pdf";
---

<BaseLayout title="Resume PDFs" description="Download PDF resumes">
  <section class="py-12">
    <Container>
      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight reveal">Resume PDFs</h1>
        <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
          Download the focused versions depending on the role.
        </p>

        <div class="mt-6 flex flex-wrap gap-3 reveal">
          <Button href={sqa}>Download SQA CV</Button>
          <Button href={iot} variant="secondary">Download IoT / Embedded CV</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>