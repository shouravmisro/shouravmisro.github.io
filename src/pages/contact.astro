---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { loadSiteJson } from "../lib/sitejson";

const data = loadSiteJson();
const b = data.basics;
---

<BaseLayout title="Contact" description="Get in touch">
  <section class="py-12">
    <Container>
      <div class="max-w-2xl">
        <h1 class="text-3xl font-extrabold tracking-tight reveal">Contact</h1>
        <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
          I’m open to opportunities in Software QA, Junior QA, and IoT / Embedded related roles.
        </p>

        <div class="mt-6 flex flex-wrap gap-3 reveal">
          <Button href={`mailto:${b.email}`}>Email</Button>
          {b.github && <Button href={b.github} variant="secondary">GitHub</Button>}
          {b.facebook && <Button href={b.facebook} variant="secondary">Facebook</Button>}
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="card p-5 reveal" data-spotlight>
            <div class="text-sm text-[rgb(var(--fg)/0.60)]">Email</div>
            <div class="mt-2 font-semibold">{b.email}</div>
          </div>

          <div class="card p-5 reveal" data-spotlight>
            <div class="text-sm text-[rgb(var(--fg)/0.60)]">Phone</div>
            <div class="mt-2 font-semibold">{b.phone}</div>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>