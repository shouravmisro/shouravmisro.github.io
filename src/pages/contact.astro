---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { site } from "../lib/site";
---
<BaseLayout title="Contact" description="Get in touch">
  <section class="py-14">
    <Container>
      <h1 class="text-3xl font-extrabold tracking-tight reveal">Contact</h1>
      <p class="mt-3 text-[rgb(var(--fg)/0.70)] reveal">
        Recruiters: email me and download my resume. Clients: reach out via email or Facebook. Collaborators: GitHub is below.
      </p>

      <div class="mt-6 flex flex-wrap gap-3 reveal">
        <Button href={`mailto:${site.email}`}>Email</Button>
        <Button href={site.github} variant="secondary">GitHub</Button>
        <Button href={site.facebook} variant="secondary">Facebook</Button>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Email</h2>
          <p class="mt-2 text-[rgb(var(--fg)/0.70)]">{site.email}</p>
        </div>
        <div class="rounded-2xl border border-[rgb(var(--border))] p-6 reveal">
          <h2 class="font-bold">Phone</h2>
          <p class="mt-2 text-[rgb(var(--fg)/0.70)]">{site.phone}</p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>