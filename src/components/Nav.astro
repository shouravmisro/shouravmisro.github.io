---
import Container from "./Container.astro";
import { loadSiteJson } from "../lib/sitejson";

const data = loadSiteJson();
const site = data.basics;

const links = [
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/achievements", label: "Achievements" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
  { href: "/create", label: "Create" },
];

const headshot = (site.headshotUrl ?? "").trim();
---

<header class="sticky top-0 z-50 border-b border-[rgb(var(--border))] bg-[rgb(var(--bg)/0.86)] backdrop-blur">
  <Container class="flex h-16 items-center justify-between gap-3">
    <!-- Brand -->
    <a href="/" class="flex min-w-0 items-center gap-3 font-bold tracking-tight">
      {headshot && (
        <img
          src={headshot}
          alt={`${site.name} headshot`}
          style="width:34px;height:34px;object-fit:cover;border-radius:9999px;"
          class="shrink-0 border border-[rgb(var(--border))]"
          loading="lazy"
        />
      )}
      <span class="min-w-0 truncate">{site.name}</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <a class="navlink text-sm text-[rgb(var(--fg)/0.72)] hover:text-[rgb(var(--fg))] transition" href={l.href}>
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="rounded-xl border border-[rgb(var(--border))] px-3 py-2 text-sm hover:bg-[rgb(var(--fg)/0.06)] transition"
        onclick="window.__theme?.toggleTheme?.()"
        aria-label="Toggle theme"
        title="Toggle light/dark"
      >
        ☾ / ☀
      </button>

      {site.github && (
        <a
          class="hidden lg:inline-flex rounded-xl border border-[rgb(var(--border))] px-3 py-2 text-sm hover:bg-[rgb(var(--fg)/0.06)] transition"
          href={site.github}
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
      )}

      <a
        class="hidden sm:inline-flex rounded-xl bg-[linear-gradient(135deg,rgb(var(--grad-a)),rgb(var(--grad-b)))] px-3 py-2 text-sm font-semibold text-white hover:opacity-90 transition"
        href="/cv"
      >
        Resume
      </a>

      <button
        id="menuBtn"
        type="button"
        class="md:hidden rounded-xl border border-[rgb(var(--border))] px-3 py-2 text-sm hover:bg-[rgb(var(--fg)/0.06)] transition"
        aria-label="Open menu"
        aria-expanded="false"
      >
        ☰
      </button>
    </div>
  </Container>

  <!-- Mobile panel -->
  <div id="mobileNav" class="md:hidden hidden border-t border-[rgb(var(--border))] bg-[rgb(var(--bg)/0.95)]">
    <Container class="py-3">
      <nav class="grid gap-1">
        {links.map((l) => (
          <a class="rounded-xl px-3 py-2 text-sm text-[rgb(var(--fg)/0.85)] hover:bg-[rgb(var(--fg)/0.06)] transition" href={l.href}>
            {l.label}
          </a>
        ))}
        <a class="rounded-xl px-3 py-2 text-sm text-[rgb(var(--fg)/0.85)] hover:bg-[rgb(var(--fg)/0.06)] transition" href="/cv">
          Resume / CV
        </a>
        {site.github && (
          <a
            class="rounded-xl px-3 py-2 text-sm text-[rgb(var(--fg)/0.85)] hover:bg-[rgb(var(--fg)/0.06)] transition"
            href={site.github}
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        )}
      </nav>
    </Container>
  </div>

  <script is:inline>
    {String.raw`
      (function () {
        const btn = document.getElementById("menuBtn");
        const nav = document.getElementById("mobileNav");
        if (!btn || !nav) return;

        function closeMenu() {
          nav.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
        }

        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          nav.classList.toggle("hidden");
          const open = !nav.classList.contains("hidden");
          btn.setAttribute("aria-expanded", open ? "true" : "false");
        });

        nav.addEventListener("click", (e) => {
          const a = e.target && e.target.closest && e.target.closest("a");
          if (a) closeMenu();
        });

        document.addEventListener("click", () => closeMenu());

        window.addEventListener("resize", () => {
          if (window.matchMedia("(min-width: 768px)").matches) closeMenu();
        });
      })();
    `}
  </script>
</header>