---
const { href, variant = "primary" } = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold transition will-change-transform";
const variants = {
  primary:
    "bg-[rgb(var(--fg))] text-[rgb(var(--bg))] hover:opacity-90 active:scale-[0.98]",
  secondary:
    "border border-[rgb(var(--border))] bg-transparent text-[rgb(var(--fg))] hover:bg-[rgb(var(--fg)/0.06)] active:scale-[0.98]",
  ghost:
    "text-[rgb(var(--fg))] hover:bg-[rgb(var(--fg)/0.06)] active:scale-[0.98]",
};
---
{href ? (
  <a class={`${base} ${variants[variant]}`} href={href}>
    <slot />
  </a>
) : (
  <button class={`${base} ${variants[variant]}`}>
    <slot />
  </button>
)}