---
type Props = {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
};

const { href, variant = "primary" } = Astro.props;

const base =
  "btnalive inline-flex items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold transition";

const variants: Record<string, string> = {
  primary:
    "bg-[rgb(var(--fg))] text-[rgb(var(--bg))] hover:opacity-90",
  secondary:
    "border border-[rgb(var(--border))] hover:bg-[rgb(var(--fg)/0.06)]",
  ghost:
    "border border-transparent hover:border-[rgb(var(--border))] hover:bg-[rgb(var(--fg)/0.04)]",
};

const cls = `${base} ${variants[variant]}`;
---

<a class={cls} href={href}>
  <slot />
</a>